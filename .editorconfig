# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.sh]
indent_size = 2

[*.{ps1,psd1}]
# ASCII only: Windows PowerShell 5.1 reads BOM-less files as the ANSI code page.
charset = unset
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[SHA256SUMS]
indent_style = unset
